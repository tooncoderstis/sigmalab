# Contoh environment PRODUKSI (EasyPanel). Salin nilainya ke panel, JANGAN commit .env asli.
# Untuk produksi Mayar: MAYAR_BASE_URL="https://api.mayar.id/hl/v2" dengan key PRODUKSI Read & Write.

DATABASE_URL="postgresql://user:strong-password@db-host:5432/sigmalabdb"
AUTH_SECRET="ganti-dengan-64-karakter-hex-acak"
MAYAR_API_KEY="key-mayar-produksi-anda"
MAYAR_BASE_URL="https://api.mayar.id/hl/v2"
NEXT_PUBLIC_APP_URL="https://sigmalab.example.com"

# Penyimpanan objek S3-compatible (Cloudflare R2 / MinIO) untuk berkas tugas (ADR-0009).
# Buat bucket khusus + atur CORS agar browser boleh PUT dari domain aplikasi.
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="sigmalab-tugas"
S3_ACCESS_KEY_ID="akses-key-produksi"
S3_SECRET_ACCESS_KEY="rahasia-produksi"

# Set "true" HANYA saat deploy pertama untuk menjalankan migrasi, lalu kembalikan "false".
RUN_MIGRATIONS="false"
