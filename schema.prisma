// ============================================================
// PRISMA SCHEMA — Portal Belajar (Dicoding-like)
// Stack: Next.js + PostgreSQL + Prisma
// Payment: Mayar
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  LEARNER
  REVIEWER
  ADMIN
  SUPER_ADMIN
  TEACHER
  STUDENT
  GUARDIAN
  STAFF
}

// Jenis instansi/program yang dilayani (satu instansi per deploy bisa punya beberapa program)
enum ProgramType {
  SEKOLAH
  BIMBEL
  KULIAH
}

// Peran guru di dalam sebuah kelas
enum TeachingRole {
  MAIN
  ASSISTANT
}

// Status kehadiran (presensi siswa per sesi & presensi harian guru)
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  SICK
  EXCUSED
}

// Jenis aktivitas penilaian (Fase 2)
enum AssessmentType {
  TUGAS
  ULANGAN
  UTS
  UAS
  PRAKTIK
  PROYEK
}

// Status pengumpulan tugas
enum WorkflowStatus {
  SUBMITTED
  GRADED
  RETURNED
}

// Status rapor
enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

// Status pengumuman
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

// Status RPP (rencana pembelajaran)
enum LessonPlanStatus {
  DRAFT
  PUBLISHED
}

// Status ketersediaan eksemplar buku
enum CopyStatus {
  AVAILABLE
  LENT
  LOST
  DAMAGED
  RETIRED
}

// Status distribusi buku
enum DistributionStatus {
  LENT
  RETURNED
  LOST
}

// Status peminjaman perpustakaan
enum LoanStatus {
  LENT
  RETURNED
  OVERDUE
  LOST
}

// Kategori inventaris
enum InventoryCategory {
  ATK
  SARPRAS
  LAINNYA
}

// Jenis pergerakan stok inventaris
enum InventoryMovementType {
  IN
  OUT
  ADJUST
}

// Status tagihan SPP
enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  CANCELLED
  EXPIRED
}

// Jenis notifikasi in-app
enum NotificationType {
  INVOICE
  GRADE
  ANNOUNCEMENT
  ACTIVITY
  SYSTEM
}

enum CourseLevel {
  PEMULA
  MENENGAH
  LANJUTAN
}

enum LessonType {
  VIDEO
  QUIZ
  SUBMISSION
  ARTICLE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// iPaymu status: berdasarkan callback iPaymu (biasanya "berhasil", "pending", "gagal")
// disimpan sebagai enum internal yang sudah dinormalisasi
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentMethod {
  VA_BCA
  VA_MANDIRI
  VA_BNI
  VA_BRI
  QRIS
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String? // nullable kalau pakai OAuth
  avatarUrl String?
  role      Role     @default(LEARNER)
  isPremium Boolean  @default(false) // shortcut flag, tapi tetap cek Enrollment/Subscription utk akses akurat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments   Enrollment[]
  progresses    Progress[]
  quizAttempts  QuizAttempt[]
  submissions   Submission[]   @relation("SubmissionOwner")
  reviewedSubs  Submission[]   @relation("SubmissionReviewer")
  certificates  Certificate[]
  payments      Payment[]
  courseReviews CourseReview[]

  // Akademik (Fase 1): multi-peran + profil + relasi kelas/presensi
  roles              UserRole[]
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  staffProfile       StaffProfile?
  guardianProfile    GuardianProfile?
  homeroomClasses    AcademicClass[]      @relation("HomeroomTeacher")
  classEnrollments   ClassEnrollment[]    @relation("ClassEnrollmentStudent")
  teachings          TeachingAssignment[] @relation("TeachingAssignmentTeacher")
  taughtSessions     AttendanceSession[]  @relation("SessionTeacher")
  createdSessions    AttendanceSession[]  @relation("SessionCreator")
  attendanceRecords  AttendanceRecord[]   @relation("AttendanceStudent")
  markedAttendance   AttendanceRecord[]   @relation("AttendanceMarker")
  teacherAttendances TeacherAttendance[]  @relation("TeacherAttendance")

  // Akademik (Fase 2): penilaian, tugas, rapor
  createdAssessments    Assessment[]           @relation("AssessmentCreator")
  assignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmitter")
  grades                Grade[]                @relation("GradeStudent")
  gradesGiven           Grade[]                @relation("GradeMarker")
  reportCards           ReportCard[]           @relation("ReportCardStudent")

  // Akademik (Fase 2B/2C): pengumuman & kegiatan
  authoredAnnouncements Announcement[]     @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  createdActivities     SchoolActivity[]   @relation("ActivityCreator")

  // Akademik (Fase 3): kurikulum/RPP & buku ajar
  lessonPlans          LessonPlan[]           @relation("LessonPlanAuthor")
  textbooksCreated     Textbook[]             @relation("TextbookCreator")
  textbookLoans        TextbookDistribution[] @relation("DistributionStudent")
  createdDistributions TextbookDistribution[] @relation("DistributionCreator")

  // Fase 4: perpustakaan & inventaris
  bookLoans          BookLoan[]          @relation("BookLoanMember")
  createdBookLoans   BookLoan[]          @relation("BookLoanCreator")
  inventoryMovements InventoryMovement[] @relation("MovementBy")

  // Fase 5: SPP/billing, notifikasi, audit
  invoices        Invoice[]      @relation("InvoiceStudent")
  createdInvoices Invoice[]      @relation("InvoiceCreator")
  notifications   Notification[]
  auditLogs       AuditLog[]     @relation("AuditActor")

  @@index([email])
}

// ============================================================
// COURSE STRUCTURE: Course -> Module -> Lesson -> (Quiz | Submission)
// ============================================================

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String
  thumbnailUrl String?
  level        CourseLevel @default(PEMULA)
  isPremium    Boolean     @default(false)
  price        Int         @default(0) // dalam Rupiah, 0 kalau gratis
  isPublished  Boolean     @default(false)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  modules         Module[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  payments        Payment[]
  reviews         CourseReview[]
  academicClasses AcademicClass[]

  @@index([categoryId])
  @@index([slug])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int // urutan modul dalam course

  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  order    Int // urutan lesson dalam module
  type     LessonType

  // Konten sesuai type
  videoUrl     String? // untuk type VIDEO (embed Youtube/Vimeo/Mux)
  articleBody  String? // untuk type ARTICLE (markdown/html)
  passingScore Int?    @default(80) // untuk type QUIZ

  quiz        Quiz?
  progresses  Progress[]
  submissions Submission[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

// ============================================================
// PROGRESS TRACKING
// ============================================================

model Progress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, lessonId]) // satu progress record per user per lesson
  @@index([userId])
  @@index([lessonId])
}

// ============================================================
// QUIZ
// ============================================================

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  options       Json // contoh: ["A. ...", "B. ...", "C. ...", "D. ..."]
  correctOption Int // index jawaban benar
  order         Int

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   Json // { questionId: chosenOptionIndex }
  score     Int
  passed    Boolean
  attemptAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
}

// ============================================================
// SUBMISSION (tugas + review mentor)
// ============================================================

model Submission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileUrl     String? // upload file (Cloudinary/UploadThing)
  repoUrl     String? // alternatif: link repo Github
  notes       String? // catatan dari learner saat submit
  status      SubmissionStatus @default(PENDING)
  feedback    String? // feedback dari reviewer
  reviewerId  String?
  reviewer    User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  @@index([userId])
  @@index([lessonId])
  @@index([status])
}

// ============================================================
// ENROLLMENT
// ============================================================

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime? // kalau course premium punya masa akses terbatas

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// ============================================================
// CERTIFICATE
// ============================================================

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certCode String   @unique // kode unik untuk verifikasi publik, misal "CERT-XJ29K1"
  pdfUrl   String?
  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([certCode])
}

// ============================================================
// PAYMENT (Mayar)
// ============================================================
// Flow: user checkout course premium -> create Payment (PENDING) -> redirect ke halaman
// pembayaran Mayar -> Mayar kirim webhook -> update status jadi SUCCESS/FAILED -> kalau
// SUCCESS, buat Enrollment

model Payment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  amount   Int // total dibayar (Rupiah)

  // Data spesifik Mayar
  mayarTransactionId String?        @unique // "transactionId" dari response create invoice Mayar
  mayarInvoiceId     String?        @unique // ID invoice/link pembayaran yang dibuat di Mayar
  merchantRefId      String? // reference id custom yang kita generate & kirim ke Mayar, dipakai mencocokkan webhook
  paymentLinkUrl     String? // URL redirect pembayaran yang dikembalikan Mayar
  paymentMethod      PaymentMethod?
  status             PaymentStatus  @default(PENDING)
  paidAt             DateTime?
  expiredAt          DateTime?
  rawWebhook         Json? // simpan payload webhook mentah dari Mayar untuk audit/debug

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([merchantRefId])
}

// ============================================================
// COURSE REVIEW (rating & komentar, opsional tapi umum di landing/detail kelas)
// ============================================================

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

// ============================================================
// AKADEMIK (FASE 1): MULTI-PERAN, PROFIL, STRUKTUR, PRESENSI
// ============================================================

// Banyak peran per user. User.role tetap sebagai peran utama (kompatibilitas).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model StudentProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nis        String?          @unique
  nisn       String?          @unique
  programId  String?
  program    Program?         @relation(fields: [programId], references: [id])
  guardianId String?
  guardian   GuardianProfile? @relation(fields: [guardianId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([programId])
  @@index([guardianId])
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip       String?  @unique
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GuardianProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  occupation String?
  students   StudentProfile[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    @unique // contoh "2025/2026"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)
  terms     Term[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Term {
  id             String          @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // contoh "Ganjil" / "Genap"
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean         @default(false)
  classes        AcademicClass[]
  assessments    Assessment[]
  reportCards    ReportCard[]
  lessonPlans    LessonPlan[]
  invoices       Invoice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Program {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  type                ProgramType          @default(SEKOLAH)
  gradeLevel          String?
  description         String?
  classes             AcademicClass[]
  subjects            Subject[]
  students            StudentProfile[]
  announcementTargets AnnouncementTarget[]
  activityTargets     ActivityTarget[]
  textbooks           Textbook[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Subject {
  id                 String               @id @default(cuid())
  name               String
  code               String?
  programId          String?
  program            Program?             @relation(fields: [programId], references: [id])
  classes            AcademicClass[]
  assignments        TeachingAssignment[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  reportEntries      ReportCardEntry[]
  lessonPlans        LessonPlan[]
  textbooks          Textbook[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([programId, name])
  @@index([programId])
}

model AcademicClass {
  id                    String                 @id @default(cuid())
  name                  String // contoh "X IPA 1"
  programId             String
  program               Program                @relation(fields: [programId], references: [id])
  termId                String
  term                  Term                   @relation(fields: [termId], references: [id])
  subjectId             String?
  subject               Subject?               @relation(fields: [subjectId], references: [id])
  courseId              String? // materi belajar opsional (Course lama)
  course                Course?                @relation(fields: [courseId], references: [id])
  homeroomTeacherId     String?
  homeroomTeacher       User?                  @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  capacity              Int?
  isActive              Boolean                @default(true)
  enrollments           ClassEnrollment[]
  assignments           TeachingAssignment[]
  sessions              AttendanceSession[]
  assessments           Assessment[]
  announcementTargets   AnnouncementTarget[]
  activityTargets       ActivityTarget[]
  lessonPlans           LessonPlan[]
  textbookDistributions TextbookDistribution[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([termId, programId, name])
  @@index([programId])
  @@index([termId])
  @@index([subjectId])
}

model ClassEnrollment {
  id         String           @id @default(cuid())
  classId    String
  class      AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation("ClassEnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model TeachingAssignment {
  id        String        @id @default(cuid())
  classId   String
  class     AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User          @relation("TeachingAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject?      @relation(fields: [subjectId], references: [id])
  role      TeachingRole  @default(MAIN)
  createdAt DateTime      @default(now())

  @@unique([classId, teacherId, subjectId])
  @@index([classId])
  @@index([teacherId])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  classId     String
  class       AcademicClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User               @relation("SessionTeacher", fields: [teacherId], references: [id])
  subjectId   String?
  subject     Subject?           @relation(fields: [subjectId], references: [id])
  date        DateTime
  startTime   String?
  endTime     String?
  topic       String?
  createdById String?
  createdBy   User?              @relation("SessionCreator", fields: [createdById], references: [id])
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([classId])
  @@index([teacherId])
  @@index([date])
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  sessionId  String
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    User              @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  note       String?
  markedAt   DateTime          @default(now())
  markedById String?
  markedBy   User?             @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model TeacherAttendance {
  id         String           @id @default(cuid())
  teacherId  String
  teacher    User             @relation("TeacherAttendance", fields: [teacherId], references: [id], onDelete: Cascade)
  date       DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([date])
}

// ============================================================
// AKADEMIK (FASE 2): PENILAIAN, TUGAS, NILAI, RAPOR
// ============================================================

// Aktivitas penilaian dalam sebuah kelas (analog AttendanceSession)
model Assessment {
  id          String                 @id @default(cuid())
  classId     String
  class       AcademicClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  termId      String?
  term        Term?                  @relation(fields: [termId], references: [id])
  type        AssessmentType         @default(TUGAS)
  title       String
  description String?
  maxScore    Int                    @default(100)
  weight      Int                    @default(1)
  dueAt       DateTime?
  published   Boolean                @default(false) // nilai tampil ke siswa/wali bila true
  createdById String?
  createdBy   User?                  @relation("AssessmentCreator", fields: [createdById], references: [id])
  grades      Grade[]
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([classId])
  @@index([subjectId])
  @@index([termId])
}

// Berkas tugas yang diunggah siswa (metadata; berkas di object storage)
model AssignmentSubmission {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User           @relation("AssignmentSubmitter", fields: [studentId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  mimeType     String
  fileSize     Int
  notes        String?
  status       WorkflowStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

// Nilai per siswa per aktivitas penilaian
model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  score        Float // 0..assessment.maxScore
  feedback     String?
  gradedById   String?
  gradedBy     User?      @relation("GradeMarker", fields: [gradedById], references: [id])
  gradedAt     DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

// Rapor per siswa per term
model ReportCard {
  id           String            @id @default(cuid())
  studentId    String
  student      User              @relation("ReportCardStudent", fields: [studentId], references: [id], onDelete: Cascade)
  termId       String
  term         Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  status       ReportCardStatus  @default(DRAFT)
  homeroomNote String?
  pdfKey       String?
  generatedAt  DateTime          @default(now())
  publishedAt  DateTime?
  updatedAt    DateTime          @updatedAt
  entries      ReportCardEntry[]

  @@unique([studentId, termId])
  @@index([studentId])
  @@index([termId])
  @@index([status])
}

// Baris nilai per mapel dalam rapor
model ReportCardEntry {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id])
  finalScore   Float
  predicate    String
  description  String?

  @@unique([reportCardId, subjectId])
  @@index([reportCardId])
  @@index([subjectId])
}

// ============================================================
// AKADEMIK (FASE 2B/2C): PENGUMUMAN & KEGIATAN SEKOLAH
// ============================================================

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String // Markdown
  status      AnnouncementStatus   @default(DRAFT)
  pinned      Boolean              @default(false)
  audienceAll Boolean              @default(false)
  authorId    String?
  author      User?                @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?
  expiresAt   DateTime?
  targets     AnnouncementTarget[]
  reads       AnnouncementRead[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([pinned])
  @@index([publishedAt])
}

// Target audiens: salah satu dari role / classId / programId
model AnnouncementTarget {
  id             String         @id @default(cuid())
  announcementId String
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  role           Role?
  classId        String?
  class          AcademicClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  programId      String?
  program        Program?       @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([classId])
  @@index([programId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

model SchoolActivity {
  id          String           @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  category    String?
  audienceAll Boolean          @default(false)
  authorId    String?
  author      User?            @relation("ActivityCreator", fields: [authorId], references: [id])
  targets     ActivityTarget[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([startAt])
}

model ActivityTarget {
  id         String         @id @default(cuid())
  activityId String
  activity   SchoolActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  role       Role?
  classId    String?
  class      AcademicClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  programId  String?
  program    Program?       @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([classId])
  @@index([programId])
}

// ============================================================
// AKADEMIK (FASE 3): KURIKULUM/RPP & BUKU AJAR
// ============================================================

model LessonPlan {
  id            String           @id @default(cuid())
  classId       String
  class         AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?         @relation(fields: [subjectId], references: [id])
  termId        String?
  term          Term?            @relation(fields: [termId], references: [id])
  authorId      String?
  author        User?            @relation("LessonPlanAuthor", fields: [authorId], references: [id])
  meetingNo     Int
  title         String
  objectives    String?
  activities    String?
  resources     String?
  assessment    String?
  scheduledDate DateTime?
  status        LessonPlanStatus @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([classId, meetingNo])
  @@index([classId])
  @@index([authorId])
}

model Textbook {
  id          String         @id @default(cuid())
  title       String
  author      String?
  publisher   String?
  isbn        String?        @unique
  subjectId   String?
  subject     Subject?       @relation(fields: [subjectId], references: [id])
  programId   String?
  program     Program?       @relation(fields: [programId], references: [id])
  gradeLevel  String?
  description String?
  fileKey     String?
  fileName    String?
  coverUrl    String?
  isActive    Boolean        @default(true)
  createdById String?
  createdBy   User?          @relation("TextbookCreator", fields: [createdById], references: [id])
  copies      TextbookCopy[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([subjectId])
  @@index([programId])
}

model TextbookCopy {
  id            String                 @id @default(cuid())
  textbookId    String
  textbook      Textbook               @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  code          String                 @unique
  status        CopyStatus             @default(AVAILABLE)
  conditionNote String?
  distributions TextbookDistribution[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([textbookId])
  @@index([status])
}

model TextbookDistribution {
  id            String             @id @default(cuid())
  copyId        String
  copy          TextbookCopy       @relation(fields: [copyId], references: [id], onDelete: Cascade)
  studentId     String
  student       User               @relation("DistributionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         AcademicClass?     @relation(fields: [classId], references: [id])
  status        DistributionStatus @default(LENT)
  distributedAt DateTime           @default(now())
  dueAt         DateTime?
  returnedAt    DateTime?
  note          String?
  createdById   String?
  createdBy     User?              @relation("DistributionCreator", fields: [createdById], references: [id])

  @@index([copyId])
  @@index([studentId])
  @@index([status])
}

// ============================================================
// FASE 4: PERPUSTAKAAN & INVENTARIS ATK/SARPRAS
// ============================================================

model LibraryBook {
  id          String        @id @default(cuid())
  title       String
  author      String?
  publisher   String?
  isbn        String?       @unique
  category    String?
  description String?
  coverUrl    String?
  isActive    Boolean       @default(true)
  copies      LibraryCopy[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([title])
}

model LibraryCopy {
  id            String      @id @default(cuid())
  bookId        String
  book          LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  code          String      @unique
  status        CopyStatus  @default(AVAILABLE)
  conditionNote String?
  loans         BookLoan[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([bookId])
  @@index([status])
}

model BookLoan {
  id          String      @id @default(cuid())
  copyId      String
  copy        LibraryCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  memberId    String
  member      User        @relation("BookLoanMember", fields: [memberId], references: [id], onDelete: Cascade)
  status      LoanStatus  @default(LENT)
  borrowedAt  DateTime    @default(now())
  dueAt       DateTime?
  returnedAt  DateTime?
  fine        Int         @default(0)
  note        String?
  createdById String?
  createdBy   User?       @relation("BookLoanCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([copyId])
  @@index([memberId])
  @@index([status])
}

model InventoryItem {
  id          String              @id @default(cuid())
  name        String
  category    InventoryCategory   @default(ATK)
  unit        String              @default("pcs")
  quantity    Int                 @default(0)
  minQuantity Int                 @default(0)
  location    String?
  note        String?
  isActive    Boolean             @default(true)
  movements   InventoryMovement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([category])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  itemId    String
  item      InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      InventoryMovementType
  quantity  Int
  note      String?
  byId      String?
  by        User?                 @relation("MovementBy", fields: [byId], references: [id])
  createdAt DateTime              @default(now())

  @@index([itemId])
  @@index([type])
}

// ============================================================
// FASE 5: SPP/BILLING, NOTIFIKASI, AUDIT
// ============================================================

model Invoice {
  id          String        @id @default(cuid())
  studentId   String
  student     User          @relation("InvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  termId      String?
  term        Term?         @relation(fields: [termId], references: [id])
  title       String
  amount      Int // Rupiah
  status      InvoiceStatus @default(UNPAID)
  dueAt       DateTime?
  paidAt      DateTime?
  method      String?
  note        String?
  createdById String?
  createdBy   User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([termId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
