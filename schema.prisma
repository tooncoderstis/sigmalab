// ============================================================
// PRISMA SCHEMA — Portal Belajar (Dicoding-like)
// Stack: Next.js + PostgreSQL + Prisma
// Payment: Mayar
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  LEARNER
  REVIEWER
  ADMIN
  SUPER_ADMIN
  TEACHER
  STUDENT
  GUARDIAN
  STAFF
}

// Jenis instansi/program yang dilayani (satu instansi per deploy bisa punya beberapa program)
enum ProgramType {
  SEKOLAH
  BIMBEL
  KULIAH
}

// Peran guru di dalam sebuah kelas
enum TeachingRole {
  MAIN
  ASSISTANT
}

// Status kehadiran (presensi siswa per sesi & presensi harian guru)
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  SICK
  EXCUSED
}

// Jenis aktivitas penilaian (Fase 2)
enum AssessmentType {
  TUGAS
  ULANGAN
  UTS
  UAS
  PRAKTIK
  PROYEK
}

// Status pengumpulan tugas
enum WorkflowStatus {
  SUBMITTED
  GRADED
  RETURNED
}

// Status rapor
enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

enum CourseLevel {
  PEMULA
  MENENGAH
  LANJUTAN
}

enum LessonType {
  VIDEO
  QUIZ
  SUBMISSION
  ARTICLE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// iPaymu status: berdasarkan callback iPaymu (biasanya "berhasil", "pending", "gagal")
// disimpan sebagai enum internal yang sudah dinormalisasi
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentMethod {
  VA_BCA
  VA_MANDIRI
  VA_BNI
  VA_BRI
  QRIS
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String? // nullable kalau pakai OAuth
  avatarUrl String?
  role      Role     @default(LEARNER)
  isPremium Boolean  @default(false) // shortcut flag, tapi tetap cek Enrollment/Subscription utk akses akurat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments   Enrollment[]
  progresses    Progress[]
  quizAttempts  QuizAttempt[]
  submissions   Submission[]   @relation("SubmissionOwner")
  reviewedSubs  Submission[]   @relation("SubmissionReviewer")
  certificates  Certificate[]
  payments      Payment[]
  courseReviews CourseReview[]

  // Akademik (Fase 1): multi-peran + profil + relasi kelas/presensi
  roles              UserRole[]
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  staffProfile       StaffProfile?
  guardianProfile    GuardianProfile?
  homeroomClasses    AcademicClass[]      @relation("HomeroomTeacher")
  classEnrollments   ClassEnrollment[]    @relation("ClassEnrollmentStudent")
  teachings          TeachingAssignment[] @relation("TeachingAssignmentTeacher")
  taughtSessions     AttendanceSession[]  @relation("SessionTeacher")
  createdSessions    AttendanceSession[]  @relation("SessionCreator")
  attendanceRecords  AttendanceRecord[]   @relation("AttendanceStudent")
  markedAttendance   AttendanceRecord[]   @relation("AttendanceMarker")
  teacherAttendances TeacherAttendance[]  @relation("TeacherAttendance")

  // Akademik (Fase 2): penilaian, tugas, rapor
  createdAssessments    Assessment[]           @relation("AssessmentCreator")
  assignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmitter")
  grades                Grade[]                @relation("GradeStudent")
  gradesGiven           Grade[]                @relation("GradeMarker")
  reportCards           ReportCard[]           @relation("ReportCardStudent")

  @@index([email])
}

// ============================================================
// COURSE STRUCTURE: Course -> Module -> Lesson -> (Quiz | Submission)
// ============================================================

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String
  thumbnailUrl String?
  level        CourseLevel @default(PEMULA)
  isPremium    Boolean     @default(false)
  price        Int         @default(0) // dalam Rupiah, 0 kalau gratis
  isPublished  Boolean     @default(false)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  modules         Module[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  payments        Payment[]
  reviews         CourseReview[]
  academicClasses AcademicClass[]

  @@index([categoryId])
  @@index([slug])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int // urutan modul dalam course

  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  order    Int // urutan lesson dalam module
  type     LessonType

  // Konten sesuai type
  videoUrl     String? // untuk type VIDEO (embed Youtube/Vimeo/Mux)
  articleBody  String? // untuk type ARTICLE (markdown/html)
  passingScore Int?    @default(80) // untuk type QUIZ

  quiz        Quiz?
  progresses  Progress[]
  submissions Submission[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

// ============================================================
// PROGRESS TRACKING
// ============================================================

model Progress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, lessonId]) // satu progress record per user per lesson
  @@index([userId])
  @@index([lessonId])
}

// ============================================================
// QUIZ
// ============================================================

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  options       Json // contoh: ["A. ...", "B. ...", "C. ...", "D. ..."]
  correctOption Int // index jawaban benar
  order         Int

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   Json // { questionId: chosenOptionIndex }
  score     Int
  passed    Boolean
  attemptAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
}

// ============================================================
// SUBMISSION (tugas + review mentor)
// ============================================================

model Submission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileUrl     String? // upload file (Cloudinary/UploadThing)
  repoUrl     String? // alternatif: link repo Github
  notes       String? // catatan dari learner saat submit
  status      SubmissionStatus @default(PENDING)
  feedback    String? // feedback dari reviewer
  reviewerId  String?
  reviewer    User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  @@index([userId])
  @@index([lessonId])
  @@index([status])
}

// ============================================================
// ENROLLMENT
// ============================================================

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime? // kalau course premium punya masa akses terbatas

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// ============================================================
// CERTIFICATE
// ============================================================

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certCode String   @unique // kode unik untuk verifikasi publik, misal "CERT-XJ29K1"
  pdfUrl   String?
  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([certCode])
}

// ============================================================
// PAYMENT (Mayar)
// ============================================================
// Flow: user checkout course premium -> create Payment (PENDING) -> redirect ke halaman
// pembayaran Mayar -> Mayar kirim webhook -> update status jadi SUCCESS/FAILED -> kalau
// SUCCESS, buat Enrollment

model Payment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  amount   Int // total dibayar (Rupiah)

  // Data spesifik Mayar
  mayarTransactionId String?        @unique // "transactionId" dari response create invoice Mayar
  mayarInvoiceId     String?        @unique // ID invoice/link pembayaran yang dibuat di Mayar
  merchantRefId      String? // reference id custom yang kita generate & kirim ke Mayar, dipakai mencocokkan webhook
  paymentLinkUrl     String? // URL redirect pembayaran yang dikembalikan Mayar
  paymentMethod      PaymentMethod?
  status             PaymentStatus  @default(PENDING)
  paidAt             DateTime?
  expiredAt          DateTime?
  rawWebhook         Json? // simpan payload webhook mentah dari Mayar untuk audit/debug

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([merchantRefId])
}

// ============================================================
// COURSE REVIEW (rating & komentar, opsional tapi umum di landing/detail kelas)
// ============================================================

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

// ============================================================
// AKADEMIK (FASE 1): MULTI-PERAN, PROFIL, STRUKTUR, PRESENSI
// ============================================================

// Banyak peran per user. User.role tetap sebagai peran utama (kompatibilitas).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model StudentProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nis        String?          @unique
  nisn       String?          @unique
  programId  String?
  program    Program?         @relation(fields: [programId], references: [id])
  guardianId String?
  guardian   GuardianProfile? @relation(fields: [guardianId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([programId])
  @@index([guardianId])
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip       String?  @unique
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GuardianProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  occupation String?
  students   StudentProfile[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    @unique // contoh "2025/2026"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)
  terms     Term[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Term {
  id             String          @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // contoh "Ganjil" / "Genap"
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean         @default(false)
  classes        AcademicClass[]
  assessments    Assessment[]
  reportCards    ReportCard[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Program {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  type        ProgramType      @default(SEKOLAH)
  gradeLevel  String?
  description String?
  classes     AcademicClass[]
  subjects    Subject[]
  students    StudentProfile[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Subject {
  id                 String               @id @default(cuid())
  name               String
  code               String?
  programId          String?
  program            Program?             @relation(fields: [programId], references: [id])
  classes            AcademicClass[]
  assignments        TeachingAssignment[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  reportEntries      ReportCardEntry[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([programId, name])
  @@index([programId])
}

model AcademicClass {
  id                String               @id @default(cuid())
  name              String // contoh "X IPA 1"
  programId         String
  program           Program              @relation(fields: [programId], references: [id])
  termId            String
  term              Term                 @relation(fields: [termId], references: [id])
  subjectId         String?
  subject           Subject?             @relation(fields: [subjectId], references: [id])
  courseId          String? // materi belajar opsional (Course lama)
  course            Course?              @relation(fields: [courseId], references: [id])
  homeroomTeacherId String?
  homeroomTeacher   User?                @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  capacity          Int?
  isActive          Boolean              @default(true)
  enrollments       ClassEnrollment[]
  assignments       TeachingAssignment[]
  sessions          AttendanceSession[]
  assessments       Assessment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([termId, programId, name])
  @@index([programId])
  @@index([termId])
  @@index([subjectId])
}

model ClassEnrollment {
  id         String           @id @default(cuid())
  classId    String
  class      AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation("ClassEnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model TeachingAssignment {
  id        String        @id @default(cuid())
  classId   String
  class     AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User          @relation("TeachingAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject?      @relation(fields: [subjectId], references: [id])
  role      TeachingRole  @default(MAIN)
  createdAt DateTime      @default(now())

  @@unique([classId, teacherId, subjectId])
  @@index([classId])
  @@index([teacherId])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  classId     String
  class       AcademicClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User               @relation("SessionTeacher", fields: [teacherId], references: [id])
  subjectId   String?
  subject     Subject?           @relation(fields: [subjectId], references: [id])
  date        DateTime
  startTime   String?
  endTime     String?
  topic       String?
  createdById String?
  createdBy   User?              @relation("SessionCreator", fields: [createdById], references: [id])
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([classId])
  @@index([teacherId])
  @@index([date])
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  sessionId  String
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    User              @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  note       String?
  markedAt   DateTime          @default(now())
  markedById String?
  markedBy   User?             @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model TeacherAttendance {
  id         String           @id @default(cuid())
  teacherId  String
  teacher    User             @relation("TeacherAttendance", fields: [teacherId], references: [id], onDelete: Cascade)
  date       DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([date])
}

// ============================================================
// AKADEMIK (FASE 2): PENILAIAN, TUGAS, NILAI, RAPOR
// ============================================================

// Aktivitas penilaian dalam sebuah kelas (analog AttendanceSession)
model Assessment {
  id          String                 @id @default(cuid())
  classId     String
  class       AcademicClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  termId      String?
  term        Term?                  @relation(fields: [termId], references: [id])
  type        AssessmentType         @default(TUGAS)
  title       String
  description String?
  maxScore    Int                    @default(100)
  weight      Int                    @default(1)
  dueAt       DateTime?
  published   Boolean                @default(false) // nilai tampil ke siswa/wali bila true
  createdById String?
  createdBy   User?                  @relation("AssessmentCreator", fields: [createdById], references: [id])
  grades      Grade[]
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([classId])
  @@index([subjectId])
  @@index([termId])
}

// Berkas tugas yang diunggah siswa (metadata; berkas di object storage)
model AssignmentSubmission {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User           @relation("AssignmentSubmitter", fields: [studentId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  mimeType     String
  fileSize     Int
  notes        String?
  status       WorkflowStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

// Nilai per siswa per aktivitas penilaian
model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  score        Float // 0..assessment.maxScore
  feedback     String?
  gradedById   String?
  gradedBy     User?      @relation("GradeMarker", fields: [gradedById], references: [id])
  gradedAt     DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

// Rapor per siswa per term
model ReportCard {
  id           String            @id @default(cuid())
  studentId    String
  student      User              @relation("ReportCardStudent", fields: [studentId], references: [id], onDelete: Cascade)
  termId       String
  term         Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  status       ReportCardStatus  @default(DRAFT)
  homeroomNote String?
  pdfKey       String?
  generatedAt  DateTime          @default(now())
  publishedAt  DateTime?
  updatedAt    DateTime          @updatedAt
  entries      ReportCardEntry[]

  @@unique([studentId, termId])
  @@index([studentId])
  @@index([termId])
  @@index([status])
}

// Baris nilai per mapel dalam rapor
model ReportCardEntry {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id])
  finalScore   Float
  predicate    String
  description  String?

  @@unique([reportCardId, subjectId])
  @@index([reportCardId])
  @@index([subjectId])
}
