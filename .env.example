# Contoh environment untuk pengembangan lokal.
# Salin menjadi .env lalu isi nilainya. JANGAN commit .env.

# Koneksi PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/sigmalabdb"

# Rahasia NextAuth (buat dengan: openssl rand -hex 32)
AUTH_SECRET="ganti-dengan-64-karakter-hex-acak"

# Mayar — gunakan key SANDBOX dari https://web.mayar.io/api-keys (scope Read & Write)
MAYAR_API_KEY="key-mayar-sandbox-anda"
MAYAR_BASE_URL="https://api.mayar.io/hl/v2"

# URL publik aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Penyimpanan objek S3-compatible (Cloudflare R2 / MinIO) untuk berkas tugas (ADR-0009)
# R2: endpoint https://<accountid>.r2.cloudflarestorage.com, region "auto", buat bucket + CORS PUT.
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="sigmalab-tugas"
S3_ACCESS_KEY_ID="akses-key-anda"
S3_SECRET_ACCESS_KEY="rahasia-anda"
